    <!-- Plugin de trayectoria aleatoria -->
    <plugin filename="libRandomActorWalkingPlugin.so" name="gz::sim::systems::RandomActorWalkingPlugin">
      <actor_name>actor_walking_03</actor_name>
      <start_x>0.0</start_x>
      <start_y>2.5</start_y>
      <start_yaw>1.57</start_yaw>   <!-- rad -->
      <ws_min_x>-2</ws_min_x><ws_max_x>2</ws_max_x>
      <ws_min_y>2</ws_min_y><ws_max_y>6</ws_max_y>
      <speed>1.0</speed>
      <z_height>0.0</z_height>
      <turn_rate>1.5</turn_rate>
      <seed>42</seed>
    </plugin>

    <plugin filename="libActorWaypointFollowerPlugin.so" name="ignition::gazebo::systems::ActorWaypointFollowerPlugin">
      <yaml_file>${WAREHOUSE_SIMULATOR_YAML}</yaml_file>
      <default_speed>1.0</default_speed>
      <default_tolerance>0.30</default_tolerance>
      <!-- <z_override>1.0</z_override>  Opcional -->
    </plugin>
  </world>
</sdf>
