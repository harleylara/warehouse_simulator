    <!-- Actors -->
    <actor name="actor_walking_00">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name='walk'>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0</time>
            <pose>-6.3 -2.1 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>0.0 -2.1 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>12</time>
            <pose>6.5 -2.1 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>18</time>
            <pose>12.8 -2.1 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>24</time>
            <pose>12.8 -2.1 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>6.5 -2.1 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>36</time>
            <pose>0.0 -2.1 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>42</time>
            <pose>-6.3 -2.1 1.0 0 0 3.142</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="actor_walking_01">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name='walk'>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0</time>
            <pose>12.8 5.1 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>12.8 1.3 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>9</time>
            <pose>12.8 1.3 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>15</time>
            <pose>6.5 1.3 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>21</time>
            <pose>0.0 1.3 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>27</time>
            <pose>-6.3 1.3 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>-6.3 1.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>36</time>
            <pose>0.0 1.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>42</time>
            <pose>6.5 1.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>48</time>
            <pose>12.8 1.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>51</time>
            <pose>12.8 1.3 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>57</time>
            <pose>12.8 5.1 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>60</time>
            <pose>12.8 5.1 1.0 0 0 -1.57</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="actor_walking_02">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name='walk'>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0</time>
            <pose>0 0 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>2</time>
            <pose>2.0 0 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
